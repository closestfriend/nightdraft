<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hnsk.bookharness</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-i</string>
    <string>/usr/bin/python3</string>
    <string>-m</string>
    <string>book</string>
    <string>run</string>
    <string>CHANGE-ME-SLUG</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/wer/wer-book-harness</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>23</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/bookharness.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/bookharness.err</string>
</dict>
</plist>
